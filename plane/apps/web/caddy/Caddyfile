{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# [team 二开] 上游每个 IP 每分钟只放行 300 个静态请求，而这个前端一次打开就会加载几百个文件，
	# 刷新几次就会 429（整页打不开）；团队常在同一出口 IP 后面，所以放宽到 6000。
	rate_limit {
		zone static {
			key {client_ip}
			events 6000
			window 1m
		}
	}

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
