# team-mcp 安装包：打成 npm tarball，由 Plane 的代理在 /team-mcp/ 下提供下载，
# 成员用 `npx -y <地址>/team-mcp/team-mcp-<版本>.tgz` 直接运行，不用克隆仓库。
FROM node:24-alpine AS build
WORKDIR /mcp
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build \
 && mkdir -p /out/team-mcp \
 && npm pack --pack-destination /out/team-mcp \
 && node -e 'const v=require("./package.json").version;require("fs").writeFileSync("/out/team-mcp/version.json",JSON.stringify({version:v,file:`team-mcp-${v}.tgz`}))'

FROM caddy:2.11.4-alpine
COPY --from=build /out /srv
CMD ["caddy", "file-server", "--root", "/srv", "--listen", ":80"]
